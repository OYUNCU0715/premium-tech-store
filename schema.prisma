// ============================================================================
// Premium Technology Store - Prisma Schema
// Database: PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum Locale {
  tr
  en
}

enum AddressType {
  SHIPPING
  BILLING
}

enum AdminRole {
  SUPER_ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  CUSTOMER_SUPPORT
  CONTENT_MANAGER
  REPORT_MANAGER
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentProvider {
  IYZICO
  PAYTR
  MANUAL
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CampaignType {
  DISCOUNT
  BONUS_POINTS
  FREE_SHIPPING
}

enum LoyaltyTransactionType {
  EARN_PURCHASE
  EARN_REVIEW
  EARN_CAMPAIGN
  REDEEM
  EXPIRE
  ADMIN_ADJUST
  REVOKE
}

enum BannerPosition {
  HERO
  CATEGORY
  PROMO
}

enum MenuPosition {
  HEADER
  FOOTER
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String
  surname       String
  phone         String?
  emailVerified Boolean     @default(false)
  role          UserRole    @default(CUSTOMER)
  loyaltyTier   LoyaltyTier @default(BRONZE)
  loyaltyPoints Int         @default(0)
  language      Locale      @default(tr)
  currency      String      @default("TRY")
  avatar        String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions            Session[]
  addresses            Address[]
  orders               Order[]
  reviews              ProductReview[]
  favorites            Favorite[]
  compareLists         CompareList[]
  carts                Cart[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@index([email])
  @@index([loyaltyTier])
  @@index([isActive])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model VerificationToken {
  id        String                @id @default(cuid())
  email     String
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model Address {
  id           String      @id @default(cuid())
  userId       String
  title        String
  fullName     String
  phone        String
  city         String
  district     String
  neighborhood String?
  addressLine  String
  zipCode      String?
  isDefault    Boolean     @default(false)
  type         AddressType

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders  Order[] @relation("ShippingAddress")
  billingOrders   Order[] @relation("BillingAddress")

  @@index([userId])
  @@index([userId, type])
  @@index([userId, isDefault])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(PRODUCT_MANAGER)
  permissions  Json?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs           AuditLog[]
  loyaltyAdjustments  LoyaltyTransaction[]
  processedRefunds    Refund[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ============================================================================
// PRODUCTS & CATEGORIES
// ============================================================================

model Category {
  id        String    @id @default(cuid())
  parentId  String?
  slug      String    @unique
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryHierarchy")
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive, order])
}

model CategoryTranslation {
  id              String @id @default(cuid())
  categoryId      String
  locale          Locale
  name            String
  description     String?
  metaTitle       String?
  metaDescription String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@index([locale])
}

model Brand {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logo     String?
  isActive Boolean @default(true)

  products Product[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id                String   @id @default(cuid())
  categoryId        String
  brandId           String?
  slug              String   @unique
  sku               String   @unique
  price             Decimal  @db.Decimal(12, 2)
  comparePrice      Decimal? @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  currency          String   @default("TRY")
  taxRate           Decimal  @default(18) @db.Decimal(5, 2)
  weight            Decimal? @db.Decimal(8, 2)
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  isBestSeller      Boolean  @default(false)
  isNew             Boolean  @default(false)
  hasDiscount       Boolean  @default(false)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  viewCount         Int      @default(0)
  orderCount        Int      @default(0)
  averageRating     Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand        Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  translations ProductTranslation[]
  images       ProductImage[]
  videos       ProductVideo[]
  variants     ProductVariant[]
  reviews      ProductReview[]
  favorites    Favorite[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([sku])
  @@index([isActive, isFeatured])
  @@index([isActive, isBestSeller])
  @@index([isActive, isNew])
  @@index([isActive, hasDiscount])
  @@index([price])
  @@index([createdAt])
  @@index([orderCount])
  @@index([averageRating])
  @@index([viewCount])
  @@index([stock])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           Locale
  name             String
  shortDescription String?
  description      String? @db.Text
  technicalSpecs   Json?
  metaTitle        String?
  metaDescription  String?
  warrantyInfo     String?
  deliveryInfo     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([productId])
  @@index([locale])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int     @default(0)
  isMain    Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isMain])
  @@index([productId, order])
}

model ProductVideo {
  id        String @id @default(cuid())
  productId String
  url       String
  title     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  price      Decimal @db.Decimal(12, 2)
  stock      Int     @default(0)
  attributes Json
  isActive   Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@index([rating])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model CompareList {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String?
  productIds Json
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

// ============================================================================
// ORDERS & PAYMENTS
// ============================================================================

model Order {
  id                      String        @id @default(uuid())
  orderNumber             String        @unique @default(cuid())
  userId                  String?
  guestEmail              String?
  guestPhone              String?
  guestName               String?
  status                  OrderStatus   @default(PENDING)
  paymentStatus           PaymentStatus @default(PENDING)
  paymentMethod           PaymentMethod
  subtotal                Decimal       @db.Decimal(12, 2)
  discount                Decimal       @default(0) @db.Decimal(12, 2)
  shippingCost            Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount               Decimal       @default(0) @db.Decimal(12, 2)
  total                   Decimal       @db.Decimal(12, 2)
  currency                String        @default("TRY")
  exchangeRate            Decimal       @default(1) @db.Decimal(10, 6)
  couponId                String?
  couponDiscount          Decimal       @default(0) @db.Decimal(12, 2)
  loyaltyPointsUsed       Int           @default(0)
  loyaltyPointsEarned     Int           @default(0)
  shippingAddressId       String?
  billingAddressId        String?
  shippingAddressSnapshot Json?
  billingAddressSnapshot  Json?
  trackingNumber          String?
  estimatedDelivery       DateTime?
  notes                   String?       @db.Text
  cancelReason            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon          Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddress Address?  @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?  @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, status])
  @@index([guestEmail])
  @@index([couponId])
  @@index([trackingNumber])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  totalPrice      Decimal @db.Decimal(12, 2)
  productSnapshot Json

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                String                   @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerPaymentId String?
  amount            Decimal                  @db.Decimal(12, 2)
  currency          String                   @default("TRY")
  status            PaymentTransactionStatus @default(PENDING)
  rawResponse       Json?
  createdAt         DateTime                 @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  paymentId   String
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?      @db.Text
  status      RefundStatus @default(REQUESTED)
  adminNote   String?      @db.Text
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  processedBy String?

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  processedByAdmin AdminUser? @relation(fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// CART
// ============================================================================

model Cart {
  id            String    @id @default(cuid())
  userId        String?
  sessionId     String
  expiresAt     DateTime?
  reminderSentAt DateTime?
  reminderCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  reminderLogs CartReminderLog[]

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@index([reminderCount])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// ============================================================================
// COUPONS & CAMPAIGNS
// ============================================================================

model Coupon {
  id                     String     @id @default(cuid())
  code                   String     @unique
  type                   CouponType
  value                  Decimal    @db.Decimal(12, 2)
  minOrderAmount         Decimal?   @db.Decimal(12, 2)
  maxDiscount            Decimal?   @db.Decimal(12, 2)
  usageLimit             Int?
  usedCount              Int        @default(0)
  validFrom              DateTime
  validUntil             DateTime
  isActive               Boolean    @default(true)
  applicableCategories   Json?
  applicableProducts     Json?
  applicableCustomerTiers Json?

  orders               Order[]
  cartReminderConfigs  CartReminderConfig[]

  @@index([code])
  @@index([isActive, validFrom, validUntil])
}

model Campaign {
  id         String       @id @default(cuid())
  type       CampaignType
  isActive   Boolean      @default(true)
  startDate  DateTime
  endDate    DateTime
  conditions Json?
  createdAt  DateTime     @default(now())

  translations CampaignTranslation[]

  @@index([isActive, startDate, endDate])
  @@index([type])
}

model CampaignTranslation {
  id          String @id @default(cuid())
  campaignId  String
  locale      Locale
  name        String
  description String? @db.Text
  bannerImage String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, locale])
  @@index([campaignId])
}

// ============================================================================
// LOYALTY
// ============================================================================

model LoyaltyTransaction {
  id          String                 @id @default(cuid())
  userId      String
  orderId     String?
  type        LoyaltyTransactionType
  points      Int
  balance     Int
  description String?
  adminId     String?
  createdAt   DateTime               @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, type])
}

model LoyaltyTierConfig {
  id              String      @id @default(cuid())
  tier            LoyaltyTier @unique
  minPoints       Int
  pointMultiplier Decimal     @default(1) @db.Decimal(4, 2)
  benefits        Json?
  isActive        Boolean     @default(true)

  @@index([tier])
  @@index([isActive])
}

// ============================================================================
// CURRENCY & EXCHANGE
// ============================================================================

model Currency {
  id            String  @id @default(cuid())
  code          String  @unique
  symbol        String
  name          String
  exchangeRate  Decimal @db.Decimal(12, 6)
  isDefault     Boolean @default(false)
  isActive      Boolean @default(true)
  decimalPlaces Int     @default(2)
  format        String?
  updatedAt     DateTime @updatedAt

  exchangeRateHistory ExchangeRateHistory[]

  @@index([code])
  @@index([isActive])
}

model ExchangeRateHistory {
  id           String   @id @default(cuid())
  currencyCode String
  rate         Decimal  @db.Decimal(12, 6)
  source       String?
  createdAt    DateTime @default(now())

  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)

  @@index([currencyCode])
  @@index([createdAt])
  @@index([currencyCode, createdAt])
}

// ============================================================================
// CONTENT & SITE SETTINGS
// ============================================================================

model Banner {
  id        String         @id @default(cuid())
  position  BannerPosition
  linkUrl   String?
  order     Int            @default(0)
  isActive  Boolean        @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime       @default(now())

  translations BannerTranslation[]

  @@index([position, isActive])
  @@index([isActive, startDate, endDate])
}

model BannerTranslation {
  id             String @id @default(cuid())
  bannerId       String
  locale         Locale
  title          String?
  subtitle       String?
  buttonText     String?
  imageUrl       String
  mobileImageUrl String?

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, locale])
  @@index([bannerId])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]

  @@index([slug])
  @@index([isActive])
}

model PageTranslation {
  id              String @id @default(cuid())
  pageId          String
  locale          Locale
  title           String
  content         String @db.Text
  metaTitle       String?
  metaDescription String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([pageId])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  group String

  @@index([key])
  @@index([group])
}

model MenuItem {
  id       String       @id @default(cuid())
  parentId String?
  position MenuPosition
  order    Int          @default(0)
  isActive Boolean      @default(true)

  parent       MenuItem?             @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]            @relation("MenuItemHierarchy")
  translations MenuItemTranslation[]

  @@index([parentId])
  @@index([position, isActive, order])
}

model MenuItemTranslation {
  id         String @id @default(cuid())
  menuItemId String
  locale     Locale
  label      String
  url        String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
  @@index([menuItemId])
}

model Announcement {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  linkUrl   String?

  translations AnnouncementTranslation[]

  @@index([isActive, startDate, endDate])
}

model AnnouncementTranslation {
  id             String @id @default(cuid())
  announcementId String
  locale         Locale
  text           String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, locale])
  @@index([announcementId])
}

model Newsletter {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@index([isActive])
}

// ============================================================================
// SHIPPING
// ============================================================================

model ShippingMethod {
  id             String  @id @default(cuid())
  provider       String
  isActive       Boolean @default(true)
  isFreeAbove    Boolean @default(false)
  freeAboveAmount Decimal? @db.Decimal(12, 2)
  baseRate       Decimal @db.Decimal(12, 2)
  estimatedDays  Int     @default(3)
  createdAt      DateTime @default(now())

  translations ShippingMethodTranslation[]

  @@index([isActive])
}

model ShippingMethodTranslation {
  id               String @id @default(cuid())
  shippingMethodId String
  locale           Locale
  name             String
  description      String?

  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@unique([shippingMethodId, locale])
  @@index([shippingMethodId])
}

// ============================================================================
// AUDIT
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([adminId, createdAt])
}

// ============================================================================
// CART REMINDER
// ============================================================================

model CartReminderConfig {
  id            String  @id @default(cuid())
  delayMinutes  Int
  maxReminders  Int     @default(3)
  isActive      Boolean @default(true)
  couponId      String?
  createdAt     DateTime @default(now())

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

model CartReminderLog {
  id        String   @id @default(cuid())
  cartId    String
  userId    String?
  email     String
  sentAt    DateTime @default(now())
  opened    Boolean  @default(false)
  converted Boolean  @default(false)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([userId])
  @@index([email])
  @@index([sentAt])
}
